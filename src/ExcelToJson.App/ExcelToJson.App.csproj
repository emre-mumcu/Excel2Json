<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ExcelToJson.App</RootNamespace>
    <AssemblyName>ExcelToJson</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <!-- WinForms global using'leri Razor/Fluent tipleriyle çakışıyor (Orientation, Appearance, Icon, Color...).
       Bu yüzden kaldırılıp yalnızca gereken .cs dosyalarında açıkça kullanılıyor. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="11.0.10" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.5" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.5" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExcelToJson.Core\ExcelToJson.Core.csproj" />
  </ItemGroup>

  <!-- Microsoft.Web.WebView2 paketi WinForms projelerinde de WPF derlemesine koşulsuz referans veriyor;
       bu da WindowsBase sürüm çakışması uyarısına (MSB3277) yol açıyor. WPF kullanılmadığı için referans kaldırılır. -->
  <Target Name="ExcludeWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
