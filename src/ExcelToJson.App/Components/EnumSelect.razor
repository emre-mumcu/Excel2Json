@* Enum değerleri için Türkçe etiketli hafif seçim kutusu *@
@typeparam TEnum where TEnum : struct, Enum

<select class="x-select @(Small ? "small" : "")" value="@Value" @onchange="OnChange" title="@Title" disabled="@Disabled" aria-label="@Title">
    @foreach (var v in Options ?? Enum.GetValues<TEnum>())
    {
        <option value="@v">@Label(v)</option>
    }
</select>

@code {
    [Parameter] public TEnum Value { get; set; }
    [Parameter] public EventCallback<TEnum> ValueChanged { get; set; }
    [Parameter] public IReadOnlyDictionary<TEnum, string>? Labels { get; set; }
    [Parameter] public IEnumerable<TEnum>? Options { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Title { get; set; }

    private string Label(TEnum v) => Labels is not null && Labels.TryGetValue(v, out var l) ? l : v.ToString();

    private async Task OnChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<TEnum>(e.Value?.ToString(), out var v))
        {
            Value = v;
            await ValueChanged.InvokeAsync(v);
        }
    }
}
